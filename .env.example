# Koi Fetch environment configuration
# ====================================
# Copy this file to `.env` and adjust the values for your machine.
# NEVER commit the real `.env`; the values below are SAFE LOCAL-DEVELOPMENT
# defaults only — never real credentials, and never real NAS paths.

# --- Required secrets (safe local values only) ---
# Password used to seed the admin account on first start.
ADMIN_PASSWORD=change-me-admin
# Key used to sign JWT access tokens. Any long random string works locally.
SECRET_KEY=change-me-secret-key

# --- Storage roots ---
# Pond (permanent / NAS) storage for completed downloads.
VIDEO_STORAGE_PATH=data/pond/video
IMAGE_STORAGE_PATH=data/pond/image
MUSIC_STORAGE_PATH=data/pond/music
# Bubble (temporary) storage for in-flight downloads.
TEMP_VIDEO_PATH=data/bubble/video
TEMP_IMAGE_PATH=data/bubble/image
TEMP_MUSIC_PATH=data/bubble/music

# --- Runtime behavior ---
# Maximum number of concurrent downloads. Must be >= 1.
MAX_CONCURRENT=3
# Download speed limit in MB/s. 0 means unlimited.
DOWNLOAD_SPEED_LIMIT=0
# Hours files remain in the Bubble before cleanup. Must be >= 1.
BUBBLE_EXPIRE_HOURS=24
# How often the worker daemon runs the cleanup pass (bubble sweep + stale-task
# expiry), in minutes. Must be >= 1. Default 60 (hourly, per PRD).
CLEANUP_INTERVAL_MINUTES=60
# A downloading task is considered stale (crashed worker) after this many
# minutes since the task was created, and is expired so it can be re-downloaded.
# The anchor is creation time (not claim time), so the risk window is queueing
# + download time — keep this comfortably above your realistic queue +
# download duration. Default 60.
STALE_DOWNLOAD_MINUTES=60

# --- Real engine integration (f2 / parse-video-py / musicdl) ---
# Adapter mode: "stub" (default, offline deterministic) | "engine" (real).
PARSER_ENGINE=stub
DOWNLOADER_ENGINE=stub
# Music search adapter mode: "stub" (deterministic offline) or "engine" (musicdl).
MUSIC_SEARCH_ENGINE=stub

# Keep parse-video-py as the fallback for video platforms f2 does not cover
# (kuaishou/bilibili/xiaohongshu/xigua/...). Set to false once f2 covers them
# to drop the legacy engine.
PARSER_LEGACY_FALLBACK=true

# Seconds before an engine HTTP request gives up (parse probe / per-read).
ENGINE_TIMEOUT_SECONDS=15.0
ENGINE_DOWNLOAD_TIMEOUT_SECONDS=30.0
# Optional http(s) proxy for engine traffic (empty = direct).
ENGINE_PROXY=
# Comma-separated musicdl source client names for the engine music branch.
MUSICDL_SOURCES=MiguMusicClient,NeteaseMusicClient,QQMusicClient,KuwoMusicClient,QianqianMusicClient
# Hot-search keywords shown on the music page (comma-separated).
HOT_KEYWORDS=周杰伦,晴天,热歌榜,邓紫棋,许嵩,民谣

# --- Web/app behavior ---
# Comma-separated list of allowed CORS origins. No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Enable debug mode (verbose logging, auto-reload). Default: false.
DEBUG=false
# Application timezone. Default: Asia/Shanghai (per PRD deployment).
TZ=Asia/Shanghai

# --- Persistence ---
# SQLAlchemy database URL. Default points at the local SQLite database
# under data/db (kept out of version control).
DATABASE_URL=sqlite:///./data/db/koifetch.db

# --- Frontend static serving ---
# Directory of the built frontend (Vite `dist`) the backend serves at "/".
# Native runs default to the repo-local frontend/dist; the Docker image
# copies the build to /app/static and sets this to that absolute path.
FRONTEND_DIST_PATH=frontend/dist
