# Koi Fetch frontend environment variables (copy to .env.local to override).
# In local development the Vite proxy forwards /api and /ws to
# http://localhost:8000, so the defaults work with no configuration.
# The Docker/nginx deployment also serves /api and /ws from the same origin.

# Base URL of the backend REST API. Relative paths are resolved against the
# page origin (the Vite dev proxy and the nginx /api location both expect this).
VITE_API_BASE_URL=/api

# Optional WebSocket base URL override, e.g. wss://koi.example.com for a
# separate WS origin. Leave empty to derive from the current location
# (ws://host/ws or wss://host/ws).
VITE_WS_BASE_URL=
