# Local product documentation and planning artifacts
/docs/prd/
/docs/superpowers/

# Isolated development worktrees
/.worktrees/

# Python virtual environments
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Test and tooling caches
.pytest_cache/

# Runtime data (bubble/pond/db) — downloaded media and local databases
/data/
# A worker run from the backend directory (CWD=backend) resolves the default
# relative roots under ./data, i.e. backend/data — keep that out of Git too.
/backend/data/

# SQLite database files (wherever they appear)
*.db
*.sqlite
*.sqlite3

# Secrets — never commit the real .env (keep .env.example tracked)
.env
.env.*
!.env.example
