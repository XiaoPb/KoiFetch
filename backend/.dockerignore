# Build context exclusions for the backend image.
# Keep the image small and never ship secrets, tests, or runtime data.

# Python virtualenvs and bytecode
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Tests are not shipped in the image
tests/

# Runtime data (SQLite, Bubble, Pond) comes from Compose bind mounts
data/

# Secrets & local env files (the real .env is passed via Compose env_file)
.env
.env.*

# Version control
.git/
.gitignore
